# Copy to .env and adjust. These values only seed the first boot; afterwards the
# configuration is edited from the UI and stored in server/data/config.json.

# --- HTTP server ---
PORT=3001
HOST=0.0.0.0

# --- Station identity ---
# Base callsign without SSID.
APRS_CALLSIGN=N0CALL
# SSID 0-15. 10 is the conventional SSID for an internet/gateway station.
APRS_SSID=10
# APRS-IS passcode for your callsign; -1 logs in receive-only.
APRS_PASSCODE=-1

# --- Direwolf KISS TCP ---
DIREWOLF_HOST=127.0.0.1
DIREWOLF_PORT=8001
# Radio channel (KISS port) used for transmit.
DIREWOLF_CHANNEL=0
APRS_PATH=WIDE1-1,WIDE2-1

# --- APRS-IS ---
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
# Server-side filter appended to the login line.
APRSIS_FILTER=m/100

# --- Behaviour ---
# rf | aprsis
APRS_DEFAULT_TRANSPORT=rf
APRS_AUTO_ACK=true
APRS_ENABLE_RF=true
APRS_ENABLE_APRSIS=true

# --- Position beacon (optional; usually configured from the UI) ---
APRS_BEACON_ENABLED=false
APRS_BEACON_INTERVAL=10
APRS_BEACON_LAT=
APRS_BEACON_LON=
APRS_BEACON_COMMENT=
APRS_BEACON_SYMBOL_TABLE=/
APRS_BEACON_SYMBOL_CODE=-
APRS_BEACON_TRANSPORT=rf
