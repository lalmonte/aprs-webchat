<?xml version="1.0" encoding="utf-8"?>
<!-- Allow http:// backends on the LAN (PC / Raspberry Pi running APRS WebChat). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
